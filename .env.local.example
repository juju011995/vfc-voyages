# Copiez ce fichier en .env.local (jamais commité, voir .gitignore) et
# remplissez les valeurs — voir les instructions de configuration Firebase.

# Config du projet Firebase (Project settings > General > Your apps > SDK setup).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Hash SHA-256 (hex) du code d'accès partagé — jamais le code en clair ici.
# Pour le générer : ouvrez la console du navigateur sur n'importe quelle page
# HTTPS et exécutez (en remplaçant VOTRE_CODE) :
#   crypto.subtle.digest("SHA-256", new TextEncoder().encode("VOTRE_CODE"))
#     .then(b => console.log([...new Uint8Array(b)].map(x => x.toString(16).padStart(2, "0")).join("")))
VITE_APP_PIN_HASH=

# Développement/tests uniquement — connecte l'app à l'émulateur Firestore
# local au lieu du vrai projet cloud (firebase emulators:start). À laisser
# vide/commenté en production.
# VITE_USE_FIREBASE_EMULATOR=true
