rules_version = '2';

// Toutes les données de l'app vivent dans une seule collection "kv" (voir
// src/lib/kv.ts). Accès réservé aux utilisateurs authentifiés — ici,
// l'authentification anonyme déclenchée après validation du code d'accès
// partagé (voir src/auth/PinGate.tsx). Ce n'est pas un vrai système de
// sécurité par utilisateur : Justine et Nathan partagent la même donnée,
// sans distinction de permissions entre eux.
service cloud.firestore {
  match /databases/{database}/documents {
    match /kv/{document} {
      allow read, write: if request.auth != null;
    }
  }
}
